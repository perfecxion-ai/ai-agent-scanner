# Flask Configuration
FLASK_ENV=development
FLASK_DEBUG=True
SECRET_KEY=
# Generate independent random values: openssl rand -hex 32
OPERATOR_API_KEY=
OPERATOR_ORGANIZATION_ID=default

# Database Configuration
DATABASE_URL=postgresql://user:password@localhost:5432/ai_agent_scanner
REDIS_URL=redis://localhost:6379/0

# AI API Keys (for testing discovered agents)
OPENAI_API_KEY=sk-your-openai-key
ANTHROPIC_API_KEY=your-anthropic-key

# Cloud Provider Credentials
AWS_ACCESS_KEY_ID=your-aws-key
AWS_SECRET_ACCESS_KEY=your-aws-secret
AZURE_TENANT_ID=your-azure-tenant
AZURE_CLIENT_ID=your-azure-client
AZURE_CLIENT_SECRET=your-azure-secret
GCP_PROJECT_ID=your-gcp-project
GCP_CREDENTIALS_PATH=/path/to/gcp-credentials.json

# Scanning Configuration
MAX_CONCURRENT_SCANS=2
SCAN_TIMEOUT_SECONDS=300
NETWORK_SCAN_THREADS=50
# API targets are denied unless included in these server-owned boundaries.
# Comma-separated CIDRs. Example: 192.0.2.0/24,2001:db8::/64
SCAN_ALLOWED_NETWORKS=
SCAN_ALLOW_LOOPBACK=false
# Absolute trusted local roots, separated by the platform path separator (: on Linux).
SCAN_ALLOWED_PATH_ROOTS=
SCAN_MAX_HOSTS=1024
SCAN_MAX_FILES=10000
SCAN_MAX_REQUESTS=500
SCAN_MAX_RESPONSE_BYTES=1048576

# Security
ENCRYPTION_KEY=your-32-byte-encryption-key

# Monitoring
SENTRY_DSN=your-sentry-dsn
PROMETHEUS_PORT=9090

# Email Configuration
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@company.com
SMTP_PASSWORD=your-app-password
