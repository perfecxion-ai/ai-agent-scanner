# Supported web/API settings. This file is not automatically loaded.
# Generate SECRET_KEY and OPERATOR_API_KEY separately with: openssl rand -hex 32
# Never commit deployment secrets. Empty OPERATOR_API_KEY disables protected API access.
SECRET_KEY=
OPERATOR_API_KEY=
OPERATOR_ORGANIZATION_ID=default
FLASK_DEBUG=false

# Durable server jobs require file-backed SQLite on a local POSIX filesystem.
DATABASE_URL=sqlite:///ai_agent_scanner.db
PORT=5000
ALLOWED_ORIGINS=http://localhost:5000

# API targets are denied until these server-owned boundaries are configured.
# Comma-separated CIDRs, for example 10.20.0.0/24.
SCAN_ALLOWED_NETWORKS=
# Both an allowed loopback CIDR and this flag are required for local API targets.
SCAN_ALLOW_LOOPBACK=false
# Absolute trusted directories, colon-separated on Linux. Empty denies files.
SCAN_ALLOWED_PATH_ROOTS=

# Keep one server process; the dispatcher holds exclusive database ownership.
MAX_CONCURRENT_SCANS=2
SCAN_MAX_QUEUED=32
SCAN_MAX_TEMPLATES=64
SCAN_TIMEOUT_SECONDS=300
SCAN_MAX_HOSTS=1024
SCAN_MAX_FILES=10000
SCAN_MAX_REQUESTS=500
SCAN_MAX_RESPONSE_BYTES=1048576
